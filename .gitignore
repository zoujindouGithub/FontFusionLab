# 二进制字体产物不入库（GitHub 100MB 限制 + 可由脚本重建）
*.ttf

# 字体源文件白名单: sources/<source-id>/*.ttf
!sources/*/*.ttf

# 构建产物与 Release 输出按目录隔离，不入库
build/
release/
archives/
*.zip

# 私有来源映射只允许存在于本机（模板 local.example.json 入库）
sources/local.json
.cache/

# Python
.venv/
.pytest_cache/
__pycache__/
*.pyc

# IDE & Tooling
.semgrep/
.vscode/
.idea/

# 渲染对比等临时产物
_tmp/
*.tmp
