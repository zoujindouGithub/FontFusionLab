{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FontFusionLab public sources",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false, "required": ["license", "files"],
      "properties": {
        "license": {"type": "string", "minLength": 1},
        "upstream": {"type": "string", "format": "uri"},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/file"}}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "oneOf": [{"required": ["path"]}, {"required": ["url"]}]
    }
  }
}
